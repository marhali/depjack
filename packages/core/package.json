{
  "name": "@depjack/core",
  "type": "module",
  "version": "1.0.4",
  "description": "Depjack standalone core.",
  "author": "Marcel Haßlinger <contact@marhali.de>",
  "license": "MIT",
  "funding": "https://github.com/marhali/depjack#donation",
  "homepage": "https://github.com/marhali/depjack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marhali/depjack.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/marhali/depjack/issues"
  },
  "keywords": [
    "enterprise",
    "typed",
    "dependency",
    "injecton",
    "core"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build": "vite build",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.0.8",
    "vite": "6.2.1",
    "vite-plugin-dts": "4.5.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.1.1"
  }
}
